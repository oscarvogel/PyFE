+    def __normalizar_items_respuesta(self, contenedor, nombre_item):
+        if not contenedor:
+            return []
+        if isinstance(contenedor, dict):
+            item = contenedor.get(nombre_item, contenedor)
+            if isinstance(item, (list, tuple)):
+                return item
+            return [item]
+        items = contenedor if isinstance(contenedor, (list, tuple)) else [contenedor]
+        normalizados = []
+        for item in items:
+            if isinstance(item, dict) and nombre_item in item:
+                normalizados.append(item[nombre_item])
+            else:
+                normalizados.append(item)
+        return [item for item in normalizados if isinstance(item, dict)]
+
+    def __normalizar_errores_respuesta(self, contenedor):
+        return self.__normalizar_items_respuesta(contenedor, "Err")
+
+    def __normalizar_eventos_respuesta(self, contenedor):
+        return self.__normalizar_items_respuesta(contenedor, "Evt")
+
+    def __normalizar_observaciones_respuesta(self, contenedor):
+        return self.__normalizar_items_respuesta(contenedor, "Obs")
+
+    def __obtener_primer_item_respuesta(self, contenedor, nombre_item):
+        items = self.__normalizar_items_respuesta(contenedor, nombre_item)
+        return items[0] if items else {}
+
+    def __limpiar_valores_vacios(self, datos):
+        limpios = {}
+        for clave, valor in datos.items():
+            if valor is None:
+                continue
+            if isinstance(valor, dict):
+                valor = self.__limpiar_valores_vacios(valor)
+                if not valor:
+                    continue
+            if valor in ([], ()):
+                continue
+            limpios[clave] = valor
+        return limpios
+
